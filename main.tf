data "azurerm_resource_group" "this" {
  name = var.resource_group_name
}

module "aks_cluster" {
  source   = "Azure/avm-res-containerservice-managedcluster/azurerm"
  version  = "0.8.4"
  for_each = var.aks_clusters

  name                                      = each.value.name
  location                                  = var.location
  parent_id                                 = data.azurerm_resource_group.this.id
  tags                                      = coalesce(each.value.tags, var.tags)
  enable_telemetry                          = coalesce(each.value.enable_telemetry, var.enable_telemetry)
  bootstrap_profile                         = each.value.bootstrap_profile
  fqdn_subdomain                            = each.value.fqdn_subdomain
  role_assignments                          = each.value.role_assignments
  storage_profile                           = each.value.storage_profile
  alert_email                               = each.value.alert_email
  onboard_alerts                            = each.value.onboard_alerts
  addon_profile_key_vault_secrets_provider  = each.value.addon_profile_key_vault_secrets_provider
  kind                                      = each.value.kind
  metrics_profile                           = each.value.metrics_profile
  node_provisioning_profile                 = each.value.node_provisioning_profile
  private_link_resources                    = each.value.private_link_resources
  agent_pools                               = each.value.agent_pools
  aad_profile                               = each.value.aad_profile
  agentpool_timeouts                        = each.value.agentpool_timeouts
  disk_encryption_set_id                    = each.value.disk_encryption_set_id
  linux_profile                             = each.value.linux_profile
  service_mesh_profile                      = each.value.service_mesh_profile
  ignore_body_changes                       = each.value.ignore_body_changes
  windows_profile                           = each.value.windows_profile
  network_profile                           = each.value.network_profile
  auto_scaler_profile                       = each.value.auto_scaler_profile
  diagnostic_settings                       = each.value.diagnostic_settings
  prometheus_workspace_id                   = each.value.prometheus_workspace_id
  addon_profile_azure_policy                = each.value.addon_profile_azure_policy
  kubernetes_version                        = each.value.kubernetes_version
  public_network_access                     = each.value.public_network_access
  windows_profile_password_version          = each.value.windows_profile_password_version
  api_server_access_profile                 = each.value.api_server_access_profile
  default_agent_pool                        = each.value.default_agent_pool
  private_endpoints                         = each.value.private_endpoints
  sku                                       = each.value.sku
  onboard_monitoring                        = each.value.onboard_monitoring
  disable_local_accounts                    = each.value.disable_local_accounts
  ingress_profile                           = each.value.ingress_profile
  private_endpoints_manage_dns_zone_group   = each.value.private_endpoints_manage_dns_zone_group
  service_principal_profile                 = each.value.service_principal_profile
  http_proxy_config                         = each.value.http_proxy_config
  managed_identities                        = each.value.managed_identities
  resource_types                            = each.value.resource_types
  addon_profile_ingress_application_gateway = each.value.addon_profile_ingress_application_gateway
  addon_profile_oms_agent                   = each.value.addon_profile_oms_agent
  identity_profile                          = each.value.identity_profile
  pod_identity_profile                      = each.value.pod_identity_profile
  maintenanceconfiguration                  = each.value.maintenanceconfiguration
  enable_rbac                               = each.value.enable_rbac
  retry                                     = each.value.retry
  timeouts                                  = each.value.timeouts
  upgrade_settings                          = each.value.upgrade_settings
  create_agentpools_before_destroy          = each.value.create_agentpools_before_destroy
  extended_location                         = each.value.extended_location
  node_resource_group                       = each.value.node_resource_group
  security_profile                          = each.value.security_profile
  addon_profiles_extra                      = each.value.addon_profiles_extra
  auto_upgrade_profile                      = each.value.auto_upgrade_profile
  dns_prefix                                = each.value.dns_prefix
  hosted_system_profile                     = each.value.hosted_system_profile
  oidc_issuer_profile                       = each.value.oidc_issuer_profile
  azure_monitor_profile                     = each.value.azure_monitor_profile
  ai_toolchain_operator_profile             = each.value.ai_toolchain_operator_profile
  kube_proxy_config                         = each.value.kube_proxy_config
  windows_profile_password                  = each.value.windows_profile_password
  addon_profile_confidential_computing      = each.value.addon_profile_confidential_computing
  cluster_timeouts                          = each.value.cluster_timeouts
  lock                                      = each.value.lock
  node_resource_group_profile               = each.value.node_resource_group_profile
  support_plan                              = each.value.support_plan
  workload_auto_scaler_profile              = each.value.workload_auto_scaler_profile
  namespace                                 = each.value.namespace
}
